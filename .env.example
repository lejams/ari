ARI_ENVIRONMENT=development
ARI_PROVIDER_MODE=fake
ARI_VOICE_TRANSPORT=realtime
ARI_DATABASE_URL=sqlite:///var/ari.db
ARI_AUTO_CREATE_SCHEMA=false
ARI_OPENAI_API_KEY=
ARI_ENABLE_ENGLISH_TECHNICAL_TEST=false
ARI_ENABLE_MVP_DEMOS=false
ARI_FEEDBACK_LANGUAGE=fr-FR
ARI_PIPELINE_ECONOMY_STT_MODEL=gpt-transcribe
ARI_PIPELINE_LOW_LATENCY_STT_MODEL=gpt-live-transcribe
ARI_PATIENT_MODEL=gpt-5.6-luna
ARI_GROUNDING_MODEL=gpt-5.6-luna
ARI_EVALUATION_MODEL=gpt-5.6-terra
ARI_TTS_MODEL=gpt-4o-mini-tts
ARI_TTS_VOICE=alloy
ARI_PATIENT_TIMEOUT_SECONDS=30
ARI_EVALUATION_TIMEOUT_SECONDS=60
ARI_TTS_TIMEOUT_SECONDS=30
ARI_REALTIME_HANDSHAKE_TIMEOUT_SECONDS=15
ARI_REALTIME_QUALITY_MODEL=gpt-realtime-2.1
ARI_REALTIME_ECONOMY_MODEL=gpt-realtime-2.1-mini

# Whisper defaults to Groq (ARI_STT_BASE_URL=https://api.groq.com/openai/v1, ARI_STT_MODEL=whisper-large-v3).
# With a single OpenAI key, point transcription at OpenAI instead:
# ARI_STT_BASE_URL=https://api.openai.com/v1
# ARI_STT_MODEL=whisper-1
# ARI_STT_API_KEY=<same key as ARI_OPENAI_API_KEY>

# Exam mode (open microphone, speech-to-speech). Set the exact model id your account offers.
# ARI_REALTIME_MODEL=gpt-realtime-mini
# ARI_REALTIME_VOICE=marin
# ARI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# ARI_REALTIME_VAD_SILENCE_MS=900
