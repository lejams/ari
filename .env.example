OPENAI_API_KEY=
ARI_FRONTEND_ORIGIN=http://localhost:5173
ARI_FEEDBACK_LANGUAGE=fr-FR

# Bases PostgreSQL (docker compose)
ARI_DATABASE_URL=postgresql+psycopg://ari_platform:ari_platform@localhost:5432/ari_platform
ARI_CONTENT_DATABASE_URL=postgresql+psycopg://ari_content:ari_content@localhost:5432/ari_content
ARI_TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres
POSTGRES_PASSWORD=postgres
ARI_PLATFORM_DB_PASSWORD=ari_platform
ARI_CONTENT_DB_PASSWORD=ari_content
ARI_POSTGRES_PORT=5432

# Pipeline de contenu
ARI_CONTENT_STORAGE_DIR=var/content
ARI_CONTENT_MODEL=gpt-5.6-luna
ARI_CONTENT_TIMEOUT_SECONDS=300
ARI_CONTENT_UPLOAD_MAX_BYTES=52428800
ARI_WORKER_POLL_SECONDS=2

# Fournisseurs (mode openai)
ARI_OPENAI_API_KEY=${OPENAI_API_KEY}
ARI_STT_API_KEY=${OPENAI_API_KEY}
ARI_STT_BASE_URL=https://api.groq.com/openai/v1
ARI_STT_MODEL=whisper-large-v3
ARI_STT_TIMEOUT_SECONDS=30

# Training (pipeline push-to-talk)
ARI_PATIENT_MODEL=gpt-5.6-luna
ARI_EVALUATION_MODEL=gpt-5.6-luna
ARI_TTS_MODEL=gpt-4o-mini-tts
ARI_TTS_VOICE=alloy
ARI_PATIENT_TIMEOUT_SECONDS=30
ARI_EVALUATION_TIMEOUT_SECONDS=60
ARI_TTS_TIMEOUT_SECONDS=30

# Examen (speech-to-speech)
ARI_REALTIME_MODEL=gpt-realtime-2.1-mini
ARI_REALTIME_VOICE=marin
ARI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
ARI_REALTIME_VAD_SILENCE_MS=900
ARI_REALTIME_CONNECT_TIMEOUT_SECONDS=15
ARI_AUDIO_SAMPLE_RATE=24000
