# Two hostnames, two applications. Caddy obtains and renews the certificates itself.
# The learner domain is public. ARI itself protects learner pages and APIs with account sessions;
# Caddy remains responsible for HTTPS and reverse proxying.
{$ARI_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8000
}

{$ARI_BACKOFFICE_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 60MB
	}
	reverse_proxy backoffice:8100
}
