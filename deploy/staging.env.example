# Copy this to the staging environment directory as .env.  It must never be copied from
# production: the staging project owns distinct named volumes (ari-staging_*).
COMPOSE_PROJECT_NAME=ari-staging
POSTGRES_PASSWORD=replace-with-a-distinct-staging-secret
ARI_PLATFORM_DB_PASSWORD=replace-with-a-distinct-staging-secret
ARI_CONTENT_DB_PASSWORD=replace-with-a-distinct-staging-secret
ARI_POSTGRES_PORT=15432
ARI_PROVIDER_MODE=fake
ARI_OPENAI_API_KEY=
ARI_STT_API_KEY=
ARI_EMAIL_MODE=log
BACKUP_AGE_RECIPIENT=age1replace_me
BACKUP_RCLONE_REMOTE=ari-backup:ari-staging-backups
BACKUP_LOCAL_DIR=/var/backups/ari-staging
BACKUP_KEEP_LOCAL=3
