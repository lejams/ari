# Copy to the project root as `.env` and adjust (`cp deploy/env.example .env`).
# Settings are read with the ARI_ prefix (backend/src/ari/config.py); docker compose reads
# the POSTGRES_* and ARI_*_DB_PASSWORD variables on first initialisation of the volume.

# --- Databases (PostgreSQL only; docker compose defaults) ---------------------------
# Learner platform database: the only one the learner application ever receives.
ARI_DATABASE_URL=postgresql+psycopg://ari_platform:ari_platform@localhost:5432/ari_platform
# Content pipeline database (PDF documents, protocols, reviews, gold): back-office and worker.
ARI_CONTENT_DATABASE_URL=postgresql+psycopg://ari_content:ari_content@localhost:5432/ari_content
# Maintenance connection used by the test suite to clone databases (a role that may CREATE DATABASE).
ARI_TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres
POSTGRES_PASSWORD=postgres
ARI_PLATFORM_DB_PASSWORD=ari_platform
ARI_CONTENT_DB_PASSWORD=ari_content
ARI_POSTGRES_PORT=5432

# --- Content pipeline ---------------------------------------------------------------
# Where uploaded PDFs and rendered pages live (never in the database).
ARI_CONTENT_STORAGE_DIR=var/content

# --- Providers ----------------------------------------------------------------------
ARI_PROVIDER_MODE=fake
ARI_OPENAI_API_KEY=
ARI_STT_API_KEY=
# Whisper via OpenAI instead of Groq:
# ARI_STT_BASE_URL=https://api.openai.com/v1
# ARI_STT_MODEL=whisper-1
