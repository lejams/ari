# Copy to the project root as `.env` and adjust (`cp deploy/env.example .env`).
# Every ARI_* key below is a field of backend/src/ari/config.py (Settings); unknown keys are
# ignored. docker compose reads POSTGRES_PASSWORD, ARI_*_DB_PASSWORD and ARI_POSTGRES_PORT on
# the first initialisation of its volume. Values shown are the defaults.

# --- Application ------------------------------------------------------------------------
ARI_ENVIRONMENT=development                 # development | test | production (cookie `secure`)
ARI_PROVIDER_MODE=fake                      # fake | openai
ARI_FRONTEND_ORIGIN=http://localhost:5173   # only extra origin allowed for mutations / CORS
ARI_FEEDBACK_LANGUAGE=fr-FR
# ARI_APPLICATION_VERSION=
# ARI_PROMPT_DIRECTORY=backend/src/ari/prompts

# --- Databases (PostgreSQL only; docker compose defaults) --------------------------------
# Learner platform database: the only one the learner application ever receives.
ARI_DATABASE_URL=postgresql+psycopg://ari_platform:ari_platform@localhost:5432/ari_platform
# Content pipeline database (PDF documents, protocols, reviews, gold): back-office and worker.
ARI_CONTENT_DATABASE_URL=postgresql+psycopg://ari_content:ari_content@localhost:5432/ari_content
# Maintenance connection used by the test suite to clone databases (a role that may CREATE DATABASE).
ARI_TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres
POSTGRES_PASSWORD=postgres
ARI_PLATFORM_DB_PASSWORD=ari_platform
ARI_CONTENT_DB_PASSWORD=ari_content
ARI_POSTGRES_PORT=5432

# --- Content pipeline (PDF → protocol drafts → gold) --------------------------------------
ARI_CONTENT_STORAGE_DIR=var/content         # uploaded PDFs and rendered pages, never in the DB
ARI_CONTENT_MODEL=gpt-5.6-terra             # segmentation, extraction, bundle drafts
ARI_CONTENT_TIMEOUT_SECONDS=300
ARI_CONTENT_UPLOAD_MAX_BYTES=52428800       # 50 MiB
ARI_WORKER_POLL_SECONDS=2
# ARI_WORKER_ID=                            # default: hostname-pid

# --- Providers (mode openai) ---------------------------------------------------------------
ARI_OPENAI_API_KEY=
# Speech-to-text (Whisper through an OpenAI-compatible endpoint; Groq by default).
ARI_STT_API_KEY=
ARI_STT_BASE_URL=https://api.groq.com/openai/v1
ARI_STT_MODEL=whisper-large-v3
ARI_STT_TIMEOUT_SECONDS=30
# With a single OpenAI key instead of Groq:
# ARI_STT_BASE_URL=https://api.openai.com/v1
# ARI_STT_MODEL=whisper-1
# ARI_STT_API_KEY=<same OpenAI key>

# Training mode (push-to-talk pipeline).
ARI_PATIENT_MODEL=gpt-5.6-luna
ARI_EVALUATION_MODEL=gpt-5.6-terra
ARI_TTS_MODEL=gpt-4o-mini-tts
ARI_TTS_VOICE=alloy
ARI_PATIENT_TIMEOUT_SECONDS=30
ARI_EVALUATION_TIMEOUT_SECONDS=60
ARI_TTS_TIMEOUT_SECONDS=30

# Exam mode (open microphone, one speech-to-speech model, pinned on every exam session).
ARI_REALTIME_MODEL=gpt-realtime-mini        # use the exact model id your account is entitled to
ARI_REALTIME_VOICE=marin
ARI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
ARI_REALTIME_VAD_SILENCE_MS=900
ARI_REALTIME_CONNECT_TIMEOUT_SECONDS=15
ARI_AUDIO_SAMPLE_RATE=24000
