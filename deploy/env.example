# Copy to the project root as `.env` and adjust (`cp deploy/env.example .env`).
#
# Three kinds of keys live here:
#   1. Read by docker compose itself (interpolation): passwords, ports, domains, image tag,
#      basic-auth credentials.
#   2. Read by the application Settings (backend/src/ari/config.py). In local development the
#      process reads them straight from this file; in production only the keys forwarded by the
#      compose `environment:` anchors reach the containers (see docker-compose.yml).
#   3. Read by deploy/backup.sh only.

# ============================================================================================
# 1. Read by docker compose only
# ============================================================================================
# Deterministic volume and network names (ari_postgres_data, ari_content_storage) for backup
# and restore.
COMPOSE_PROJECT_NAME=ari

# Superuser and the two role passwords. Applied on the FIRST initialisation of the data volume
# only; rotating later needs an ALTER ROLE, not just an edit here. Generate with `openssl rand -hex 24`.
POSTGRES_PASSWORD=postgres
ARI_PLATFORM_DB_PASSWORD=ari_platform
ARI_CONTENT_DB_PASSWORD=ari_content
# Postgres is published on 127.0.0.1 only; never expose it publicly.
ARI_POSTGRES_PORT=5432

# The two DNS names that point at this server (Caddy obtains a certificate for each).
ARI_DOMAIN=app-staging.example.com
ARI_BACKOFFICE_DOMAIN=admin-staging.example.com

# Pins the image built by deploy.sh so rollback is `ARI_IMAGE_TAG=<sha> docker compose … up -d
# --no-build`. Leave unset locally; deploy.sh sets it to the git short SHA.
# ARI_IMAGE_TAG=

# HTTP basic auth on the learner domain (the private-alpha gate). The hash contains `$`, so the
# single quotes are MANDATORY or compose interpolation mangles it. Generate with:
#   docker run --rm caddy:2.10-alpine caddy hash-password --plaintext '<password>'
ARI_APP_BASIC_AUTH_USER=ari
ARI_APP_BASIC_AUTH_HASH='replace-me'

# ============================================================================================
# 2. Read by Settings (local dev directly; production through the compose environment lists)
# ============================================================================================
ARI_ENVIRONMENT=development                 # development | test | production (cookie `secure`)
ARI_PROVIDER_MODE=fake                      # fake | openai
ARI_FRONTEND_ORIGIN=http://localhost:5173   # only extra origin allowed for mutations / CORS
ARI_FEEDBACK_LANGUAGE=fr-FR
ARI_SERVICE_PAUSED=false                    # true refuses new learner sessions; history stays readable
# ARI_APPLICATION_VERSION=
# ARI_PROMPT_DIRECTORY=backend/src/ari/prompts

# Databases (local dev). In production these are set by the compose files from the passwords above.
ARI_DATABASE_URL=postgresql+psycopg://ari_platform:ari_platform@localhost:5432/ari_platform
ARI_CONTENT_DATABASE_URL=postgresql+psycopg://ari_content:ari_content@localhost:5432/ari_content
# Maintenance connection used by the test suite to clone databases (a role that may CREATE DATABASE).
ARI_TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres

# Content pipeline (PDF → protocol drafts → gold).
ARI_CONTENT_STORAGE_DIR=var/content         # uploaded PDFs and rendered pages, never in the DB
ARI_CONTENT_MODEL=gpt-5.6-terra             # segmentation, extraction, bundle drafts
ARI_CONTENT_TIMEOUT_SECONDS=300
ARI_CONTENT_UPLOAD_MAX_BYTES=52428800       # 50 MiB
ARI_WORKER_POLL_SECONDS=2
# ARI_WORKER_ID=                            # default: hostname-pid

# Providers (mode openai).
ARI_OPENAI_API_KEY=
# Speech-to-text (Whisper through an OpenAI-compatible endpoint; Groq by default).
ARI_STT_API_KEY=
ARI_STT_BASE_URL=https://api.groq.com/openai/v1
ARI_STT_MODEL=whisper-large-v3
ARI_STT_TIMEOUT_SECONDS=30
# With a single OpenAI key instead of Groq:
# ARI_STT_BASE_URL=https://api.openai.com/v1
# ARI_STT_MODEL=whisper-1
# ARI_STT_API_KEY=<same OpenAI key>

# Training mode (push-to-talk pipeline).
ARI_PATIENT_MODEL=gpt-5.6-luna
ARI_EVALUATION_MODEL=gpt-5.6-terra
ARI_TTS_MODEL=gpt-4o-mini-tts
ARI_TTS_VOICE=alloy
ARI_PATIENT_TIMEOUT_SECONDS=30
ARI_EVALUATION_TIMEOUT_SECONDS=60
ARI_TTS_TIMEOUT_SECONDS=30

# Exam mode (open microphone, one speech-to-speech model, pinned on every exam session).
ARI_REALTIME_MODEL=gpt-realtime-mini        # use the exact model id your account is entitled to
ARI_REALTIME_VOICE=marin
ARI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
ARI_REALTIME_VAD_SILENCE_MS=900
ARI_REALTIME_CONNECT_TIMEOUT_SECONDS=15
ARI_AUDIO_SAMPLE_RATE=24000

# Learner accounts. In production ARI_PUBLIC_URL is set by compose from ARI_DOMAIN: e-mailed
# links always point there, never at the Host header of a request.
# ARI_PUBLIC_URL=http://localhost:8000
ARI_LEARNER_SESSION_DAYS=30
ARI_LEARNER_ACTIVATION_HOURS=48
ARI_LEARNER_RESET_MINUTES=60
# E-mail: "log" writes messages (and their links) to the application log instead of sending
# them, for development only. "smtp" sends through any relay (Brevo, Scaleway TEM, Postmark...).
ARI_EMAIL_MODE=log                          # log | smtp
ARI_EMAIL_FROM=ARI <no-reply@example.com>   # an address of a domain the relay may send for
ARI_SMTP_HOST=
ARI_SMTP_PORT=587
ARI_SMTP_USERNAME=
ARI_SMTP_PASSWORD=
ARI_SMTP_SECURITY=starttls                  # starttls (587) | ssl (465) | none (local relay)

# ============================================================================================
# 3. Read by deploy/backup.sh only
# ============================================================================================
# age recipient (public key) the nightly backup is encrypted to; keep the private key in your
# password manager, never on the server. Generate a keypair with `age-keygen`.
BACKUP_AGE_RECIPIENT=age1replace_me
# rclone remote:bucket/prefix the encrypted set is copied to (configure with `rclone config`).
BACKUP_RCLONE_REMOTE=ari-backup:ari-backups
# Dead-man's-switch URL pinged on success (and <url>/fail on failure), e.g. healthchecks.io.
BACKUP_HEALTHCHECK_URL=
# Local staging directory and how many recent encrypted sets to keep on the server.
BACKUP_LOCAL_DIR=/var/backups/ari
BACKUP_KEEP_LOCAL=3
